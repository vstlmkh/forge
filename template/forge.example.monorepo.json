{
  "forge_version": "1.0.1",
  "generator": {
    "name": "forge",
    "url": "https://github.com/vstlmkh/forge",
    "version": "1.0.1"
  },
  "attribution": true,
  "project": {
    "name": "Acme App",
    "description": "A single-repository web application."
  },
  "paths": {
    "tracker": "docs/agile",
    "kb": "docs/knowledge"
  },
  "repos": {
    "root": {
      "path": ".",
      "branch": "main",
      "remote": "acme/app",
      "submodule": false
    }
  },
  "scopes": {
    "api": {
      "repo": "root",
      "agent": "api-engineer",
      "kb_scope": "api",
      "stack": "Python 3.12, FastAPI, SQLAlchemy, Postgres",
      "workdir": "services/api",
      "notes": "Migrations live in services/api/alembic; never edit an applied revision."
    },
    "web": {
      "repo": "root",
      "agent": "web-engineer",
      "kb_scope": "web",
      "stack": "TypeScript, React 19, Vite",
      "workdir": "apps/web"
    },
    "infra": {
      "repo": null,
      "agent": [
        "api-engineer",
        "web-engineer"
      ],
      "kb_scope": "shared",
      "code": false
    },
    "docs": {
      "repo": null,
      "agent": [
        "api-engineer",
        "web-engineer",
        "pm"
      ],
      "kb_scope": "shared",
      "code": false
    }
  },
  "checks": {
    "api": [
      {
        "id": "tests",
        "title": "Tests",
        "command": "pytest -q",
        "cwd": "services/api",
        "available": true
      },
      {
        "id": "lint",
        "title": "Lint",
        "command": "ruff check .",
        "cwd": "services/api",
        "available": true
      },
      {
        "id": "types",
        "title": "Types",
        "command": "mypy .",
        "cwd": "services/api",
        "available": false,
        "blocked_by": "TASK-0003",
        "note": "mypy is not configured yet"
      }
    ],
    "web": [
      {
        "id": "tests",
        "title": "Tests",
        "command": "npm test",
        "cwd": "apps/web",
        "available": true
      },
      {
        "id": "types",
        "title": "Types",
        "command": "npm run tsc",
        "cwd": "apps/web",
        "available": true
      },
      {
        "id": "build",
        "title": "Production build",
        "command": "npm run build",
        "cwd": "apps/web",
        "available": true
      }
    ],
    "infra": [
      {
        "id": "compose",
        "title": "Compose files parse",
        "command": "docker compose config -q",
        "available": true
      }
    ],
    "docs": [
      {
        "id": "tracker",
        "title": "Tracker integrity",
        "command": "python3 .claude/scripts/agile.py lint",
        "available": true
      },
      {
        "id": "kb",
        "title": "Knowledge-base integrity",
        "command": "python3 .claude/scripts/kb.py lint",
        "available": true
      }
    ]
  },
  "kb": {
    "scopes": [
      "api",
      "web",
      "shared"
    ],
    "shared_scope": "shared",
    "locked_types": {
      "api-contract": [
        "shared"
      ]
    },
    "forbidden_dirs": []
  },
  "git": {
    "commit_style": "conventional-third-person",
    "require_refs_trailer": true,
    "pull_requests": true,
    "branch_prefixes": [
      "feat",
      "fix",
      "chore",
      "style",
      "refactor",
      "docs",
      "test",
      "perf"
    ],
    "never_commit": [
      ".env",
      "node_modules/",
      "dist/",
      "__pycache__/",
      ".idea/"
    ]
  },
  "policy": {
    "test_first": true,
    "require_docs": true,
    "stale_claim_hours": 24
  }
}
