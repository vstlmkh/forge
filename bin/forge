#!/usr/bin/env python3
"""forge - install and maintain the agent harness in a project.

    forge init [TARGET]        install the harness into TARGET (default: cwd)
    forge agents [TARGET]      re-render the per-scope engineer agents from forge.json
    forge upgrade [TARGET]     refresh the scripts, skills, commands and specs in place
    forge doctor [TARGET]      run the installed harness's self-check
    forge detect [TARGET]      print the shape forge infers, and change nothing
    forge self-update          pull the newest forge into its own checkout
    forge where                print where forge is installed
    forge version

`init` is interactive unless you pass --auto or --preset. Everything it asks
ends up in TARGET/forge.json, which is the single source of truth afterwards:
scopes, repositories, owning agents and the Definition-of-Done matrix.

Flags
    --auto                         infer the shape from the repository, ask nothing
    --preset monorepo|submodules   skip the interview, start from an example
    --name NAME                    project name (default: the directory name)
    --force                        overwrite files that already exist
    --no-claude-md                 do not touch TARGET/CLAUDE.md
    --no-attribution               do not sign the files forge generates
"""

from __future__ import annotations

import json
import os
import shutil
import sys

# realpath, not abspath: the usual installation is a symlink on PATH pointing
# into ~/.forge, and template/ has to be found relative to the real file.
HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
TEMPLATE = os.path.join(HERE, "template")
VERSION = "1.0.0"
FORGE_NAME = "forge"
FORGE_URL = "https://github.com/vstlmkh/forge"


def credit(cfg: dict, kind: str) -> str:
    """The attribution line, or nothing when a project has turned it off.

    forge signs what forge generates: the managed CLAUDE.md block and the
    rendered agents here, the two INDEX.md boards in the harness itself. It
    never signs a commit, a pull request, or a file somebody on the project
    wrote - and the line is plain text with a link, so anyone can see it and
    delete it. `"attribution": false` in forge.json does that globally."""
    if not cfg.get("attribution", True):
        return ""
    if kind == "comment":
        return (f"<!-- Generated by {FORGE_NAME} - {FORGE_URL} - "
                "edit forge.json and re-run `forge agents`, do not edit this file -->")
    return (f"---\n\nThis harness is [{FORGE_NAME}]({FORGE_URL}); "
            "`forge upgrade` refreshes it and `forge doctor` checks it.")

# payload copied verbatim: (source relative to template, destination relative to target)
PAYLOAD = [
    (".claude/scripts", ".claude/scripts"),
    (".claude/skills", ".claude/skills"),
    (".claude/commands", ".claude/commands"),
    ("docs/agile/README.md", "docs/agile/README.md"),
    ("docs/agile/SCHEMA.md", "docs/agile/SCHEMA.md"),
    ("docs/knowledge/README.md", "docs/knowledge/README.md"),
]
# the two role agents that exist in every project; the engineers are rendered
STATIC_AGENTS = ["pm.md", "qa.md"]
TRACKER_DIRS = ["backlog", "tasks", "bugs"]


# --------------------------------------------------------------------------
# small helpers
# --------------------------------------------------------------------------

def say(msg: str) -> None:
    print(msg)


def die(msg: str) -> "None":
    print(f"fatal: {msg}", file=sys.stderr)
    raise SystemExit(1)


def ask(prompt: str, default: str = "") -> str:
    suffix = f" [{default}]" if default else ""
    try:
        got = input(f"{prompt}{suffix}: ").strip()
    except EOFError:
        got = ""
    return got or default


def ask_yes(prompt: str, default: bool = True) -> bool:
    d = "Y/n" if default else "y/N"
    got = ask(f"{prompt} ({d})", "")
    if not got:
        return default
    return got.lower().startswith("y")


def copy(src: str, dst: str, force: bool) -> None:
    if os.path.isdir(src):
        for name in sorted(os.listdir(src)):
            copy(os.path.join(src, name), os.path.join(dst, name), force)
        return
    if os.path.basename(src).endswith(".tmpl"):
        return
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if os.path.exists(dst) and not force:
        with open(src, encoding="utf-8") as a, open(dst, encoding="utf-8") as b:
            if a.read() == b.read():
                return
        say(f"  kept (differs, use --force to overwrite): {dst}")
        return
    shutil.copyfile(src, dst)


def read_json(path: str) -> dict:
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


def write_json(path: str, data: dict) -> None:
    with open(path, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")


# --------------------------------------------------------------------------
# detection - infer the project's shape so that init has something to propose
# --------------------------------------------------------------------------

# manifest -> (stack label, function returning check rows)
def _read(path: str) -> str:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except OSError:
        return ""


def _npm_checks(d: str) -> tuple[str, list[dict]]:
    try:
        pkg = json.loads(_read(os.path.join(d, "package.json")) or "{}")
    except json.JSONDecodeError:
        pkg = {}
    scripts = pkg.get("scripts") or {}
    deps = {**(pkg.get("dependencies") or {}), **(pkg.get("devDependencies") or {})}
    stack = ", ".join(n for n in ("next", "react", "vue", "svelte", "express", "nest",
                                  "typescript", "vite") if n in deps) or "Node.js"
    rows = []
    for cid, title, names in (
        ("tests", "Tests", ("test", "test:ci")),
        ("types", "Types", ("tsc", "typecheck", "type-check")),
        ("lint", "Lint", ("lint:errors", "lint")),
        ("build", "Production build", ("build",)),
    ):
        hit = next((n for n in names if n in scripts), None)
        if hit:
            rows.append({"id": cid, "title": title, "command": f"npm run {hit}"
                         if hit != "test" else "npm test", "available": True})
    return stack, rows


def _python_checks(d: str) -> tuple[str, list[dict]]:
    text = _read(os.path.join(d, "pyproject.toml")) + _read(os.path.join(d, "requirements.txt"))
    rows = []
    if "pytest" in text or os.path.isdir(os.path.join(d, "tests")):
        rows.append({"id": "tests", "title": "Tests", "command": "pytest -q", "available": True})
    if "ruff" in text:
        rows.append({"id": "lint", "title": "Lint", "command": "ruff check .", "available": True})
    if "mypy" in text:
        rows.append({"id": "types", "title": "Types", "command": "mypy .", "available": True})
    stack = "Django" if "django" in text.lower() else \
            "FastAPI" if "fastapi" in text.lower() else \
            "Flask" if "flask" in text.lower() else "Python"
    return stack, rows


def _php_checks(d: str) -> tuple[str, list[dict]]:
    try:
        pkg = json.loads(_read(os.path.join(d, "composer.json")) or "{}")
    except json.JSONDecodeError:
        pkg = {}
    scripts = pkg.get("scripts") or {}
    deps = {**(pkg.get("require") or {}), **(pkg.get("require-dev") or {})}
    rows = []
    if "test" in scripts or os.path.isdir(os.path.join(d, "tests")):
        rows.append({"id": "tests", "title": "Tests", "command": "composer test"
                     if "test" in scripts else "./vendor/bin/phpunit", "available": True})
    if any("pint" in k for k in deps):
        rows.append({"id": "style", "title": "Style", "command": "./vendor/bin/pint --test",
                     "available": True})
    if any("phpstan" in k or "larastan" in k for k in deps):
        rows.append({"id": "stan", "title": "Static analysis",
                     "command": "./vendor/bin/phpstan analyse", "available": True})
    stack = "Laravel" if any("laravel" in k for k in deps) else \
            "Symfony" if any("symfony" in k for k in deps) else "PHP"
    return stack, rows


def _go_checks(d: str) -> tuple[str, list[dict]]:
    return "Go", [
        {"id": "tests", "title": "Tests", "command": "go test ./...", "available": True},
        {"id": "vet", "title": "Vet", "command": "go vet ./...", "available": True},
    ]


def _rust_checks(d: str) -> tuple[str, list[dict]]:
    return "Rust", [
        {"id": "tests", "title": "Tests", "command": "cargo test", "available": True},
        {"id": "lint", "title": "Lint", "command": "cargo clippy -- -D warnings", "available": True},
    ]


def _dart_checks(d: str) -> tuple[str, list[dict]]:
    flutter = "flutter" in _read(os.path.join(d, "pubspec.yaml"))
    return ("Flutter" if flutter else "Dart"), [
        {"id": "tests", "title": "Tests", "command": "flutter test" if flutter else "dart test",
         "available": True},
        {"id": "lint", "title": "Analyze",
         "command": "flutter analyze" if flutter else "dart analyze", "available": True},
    ]


MANIFESTS = [
    ("package.json", _npm_checks),
    ("pyproject.toml", _python_checks),
    ("requirements.txt", _python_checks),
    ("composer.json", _php_checks),
    ("go.mod", _go_checks),
    ("Cargo.toml", _rust_checks),
    ("pubspec.yaml", _dart_checks),
]

# where a monorepo usually hides its parts; "." is tried first
SEARCH_DIRS = [".", "apps", "services", "packages", "src", "backend", "frontend", "api", "web"]
SKIP_DIRS = {"node_modules", "vendor", ".git", "dist", "build", ".next", "venv", ".venv"}


def _branch_of(path: str) -> str:
    import subprocess
    try:
        res = subprocess.run(["git", "-C", path, "rev-parse", "--abbrev-ref", "HEAD"],
                             capture_output=True, text=True, timeout=10)
        name = res.stdout.strip()
        return name if name and name != "HEAD" else "main"
    except (OSError, subprocess.SubprocessError):
        return "main"


def _submodules(target: str) -> list[tuple[str, str]]:
    """[(name, path)] from .gitmodules, in declaration order."""
    text = _read(os.path.join(target, ".gitmodules"))
    out, name = [], None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("[submodule"):
            name = line.split('"')[1] if '"' in line else None
        elif line.startswith("path") and "=" in line:
            path = line.split("=", 1)[1].strip()
            out.append((os.path.basename(name or path), path))
    return out


def _manifest_in(d: str):
    for manifest, fn in MANIFESTS:
        if os.path.isfile(os.path.join(d, manifest)):
            return manifest, fn
    return None, None


def _candidate_dirs(target: str) -> list[str]:
    """Directories that look like a deployable part, as paths relative to target."""
    found = []
    for rel in SEARCH_DIRS:
        d = target if rel == "." else os.path.join(target, rel)
        if not os.path.isdir(d):
            continue
        if _manifest_in(d)[0]:
            found.append("." if rel == "." else rel)
            continue
        if rel == ".":
            continue
        for name in sorted(os.listdir(d)):
            if name.startswith(".") or name in SKIP_DIRS:
                continue
            sub = os.path.join(d, name)
            if os.path.isdir(sub) and _manifest_in(sub)[0]:
                found.append(os.path.join(rel, name))
    # "." only counts when nothing more specific was found
    specific = [f for f in found if f != "."]
    return specific or found


def detect(target: str) -> dict:
    """Infer repositories, scopes and checks. Everything here is a proposal:
    `forge doctor` and the user decide whether it is true."""
    subs = _submodules(target)
    repos: dict = {}
    scopes: dict = {}
    checks: dict = {}

    if subs:
        repos["harness"] = {"path": ".", "branch": _branch_of(target),
                            "submodule": False, "role": "harness"}
        parts = [(name, path, os.path.join(target, path)) for name, path in subs]
    else:
        repos["root"] = {"path": ".", "branch": _branch_of(target), "submodule": False}
        parts = []
        for rel in _candidate_dirs(target):
            name = "app" if rel == "." else os.path.basename(rel)
            parts.append((name, rel, os.path.join(target, rel)))

    for name, rel, abs_dir in parts:
        scope = name.replace("_", "-").lower()
        # a submodule root may hold the manifest one level down (a deployment repo)
        search = abs_dir
        if not _manifest_in(abs_dir)[0]:
            for inner in ("app", "src", "server", "client"):
                if _manifest_in(os.path.join(abs_dir, inner))[0]:
                    search = os.path.join(abs_dir, inner)
                    break
        manifest, fn = _manifest_in(search)
        stack, rows = fn(search) if fn else ("", [])
        workdir = os.path.relpath(search, target)
        if subs:
            repos[scope] = {"path": rel, "branch": _branch_of(abs_dir), "submodule": True}
            repo_key = scope
        else:
            repo_key = "root"
        for row in rows:
            if workdir != ".":
                row["cwd"] = workdir
        scopes[scope] = {"repo": repo_key, "agent": f"{scope}-engineer", "kb_scope": scope,
                         "stack": stack, "workdir": workdir, "code": True}
        checks[scope] = rows

    return {"repos": repos, "scopes": scopes, "checks": checks,
            "submodules": bool(subs)}


def assemble(project: str, repos: dict, scopes: dict, checks: dict,
             forbidden: list[str], never: list[str]) -> dict:
    """Add the two non-code scopes every project needs, and the defaults."""
    code_agents = sorted({a for s in scopes.values()
                          for a in ([s["agent"]] if isinstance(s.get("agent"), str)
                                    else s.get("agent") or [])})
    scopes = dict(scopes)
    scopes["infra"] = {"repo": None, "agent": code_agents or ["pm"], "kb_scope": "shared",
                       "code": False}
    scopes["docs"] = {"repo": None, "agent": (code_agents or []) + ["pm"],
                      "kb_scope": "shared", "code": False}
    checks = dict(checks)
    checks["infra"] = [{"id": "tracker", "title": "Tracker integrity",
                        "command": "python3 .claude/scripts/agile.py lint", "available": True}]
    checks["docs"] = [
        {"id": "tracker", "title": "Tracker integrity",
         "command": "python3 .claude/scripts/agile.py lint", "available": True},
        {"id": "kb", "title": "Knowledge-base integrity",
         "command": "python3 .claude/scripts/kb.py lint", "available": True},
    ]
    return {
        "forge_version": VERSION,
        "generator": {"name": FORGE_NAME, "url": FORGE_URL, "version": VERSION},
        "attribution": ATTRIBUTION[0],
        "project": {"name": project, "description": ""},
        "paths": {"tracker": "docs/agile", "kb": "docs/knowledge"},
        "repos": repos,
        "scopes": scopes,
        "checks": checks,
        "kb": {
            "scopes": [s["kb_scope"] for s in scopes.values() if s.get("code")] + ["shared"],
            "shared_scope": "shared",
            "locked_types": {"api-contract": ["shared"]},
            "forbidden_dirs": forbidden,
        },
        "git": {
            "commit_style": "conventional-third-person",
            "require_refs_trailer": True,
            "pull_requests": True,
            "branch_prefixes": ["feat", "fix", "chore", "style", "refactor",
                                "docs", "test", "perf"],
            "never_commit": never,
        },
        "policy": {"test_first": True, "require_docs": True, "stale_claim_hours": 24},
    }


# set once from the command line, read by assemble()
ATTRIBUTION = [True]

DEFAULT_NEVER = [".env", "node_modules/", "vendor/", "dist/", "build/", ".idea/"]


def describe(found: dict) -> list[str]:
    lines = []
    shape = "super-repo with submodules" if found["submodules"] else "single repository"
    lines.append(f"  layout: {shape}")
    for name, s in found["scopes"].items():
        rows = found["checks"].get(name) or []
        cmds = ", ".join(r["command"] for r in rows) or "no checks found"
        lines.append(f"  scope {name}: {s['stack'] or 'unknown stack'} in {s['workdir']} "
                     f"-> {cmds}")
    if not found["scopes"]:
        lines.append("  no scopes found - nothing here looks like a buildable part")
    return lines


# --------------------------------------------------------------------------
# the interview
# --------------------------------------------------------------------------

def interview(target: str, name: str) -> dict:
    say("")
    say("Describing the project. Everything here lands in forge.json and can be")
    say("edited afterwards; nothing is baked into the scripts.")
    say("")

    project = ask("Project name", name)

    found = detect(target)
    if found["scopes"]:
        say("")
        say("This is what the repository looks like from here:")
        for line in describe(found):
            say(line)
        say("")
        if ask_yes("Use that, and skip the rest of the questions?", True):
            return finish(project, found["repos"], found["scopes"], found["checks"])
        say("")

    layout = ask("Layout - (1) one repository, (2) super-repo with submodules",
                 "2" if found["submodules"] else "1")
    submodules = layout.strip().startswith("2")

    repos: dict = {}
    scopes: dict = {}
    checks: dict = {}

    if submodules:
        root_branch = ask("Tracked branch of this super-repo", "main")
        root_remote = ask("Super-repo remote (owner/name, blank to skip)", "")
        repos["harness"] = {"path": ".", "branch": root_branch, "submodule": False,
                            "role": "harness"}
        if root_remote:
            repos["harness"]["remote"] = root_remote
    else:
        root_branch = ask("Tracked branch", "main")
        root_remote = ask("Remote (owner/name, blank to skip)", "")
        repos["root"] = {"path": ".", "branch": root_branch, "submodule": False}
        if root_remote:
            repos["root"]["remote"] = root_remote

    raw = ask("Code scopes, comma separated (one per implementable slice)",
              "backend, frontend")
    names = [s.strip() for s in raw.split(",") if s.strip()]
    if not names:
        die("a tracker needs at least one scope")

    for scope in names:
        say("")
        say(f"-- scope '{scope}'")
        if submodules:
            path = ask(f"  submodule path for '{scope}'", scope)
            branch = ask("  its tracked branch", "main")
            remote = ask("  its remote (owner/name, blank to skip)", "")
            repos[scope] = {"path": path, "branch": branch, "submodule": True}
            if remote:
                repos[scope]["remote"] = remote
            repo_key = scope
            workdir = ask("  directory its commands run from", path)
        else:
            repo_key = "root"
            workdir = ask("  directory its commands run from", ".")
        agent = ask("  agent that implements it", f"{scope}-engineer")
        stack = ask("  stack, in one line", "")
        notes = ask("  anything an engineer must know first (blank to skip)", "")

        scopes[scope] = {
            "repo": repo_key,
            "agent": agent,
            "kb_scope": scope,
            "stack": stack,
            "workdir": workdir,
            "code": True,
        }
        if notes:
            scopes[scope]["notes"] = notes

        rows = []
        say("  Definition-of-Done checks. Blank skips a row; a row you cannot run")
        say("  today still belongs here - it will be recorded as unavailable.")
        for cid, title, hint in (
            ("tests", "Tests", "npm test / pytest -q / composer test"),
            ("lint", "Lint", "eslint / ruff check . / pint --test"),
            ("types", "Types", "tsc --noEmit / mypy ."),
            ("build", "Production build", "npm run build"),
        ):
            cmd = ask(f"    {title} command ({hint})", "")
            if not cmd:
                continue
            available = ask_yes(f"    does `{cmd}` run successfully today?", True)
            row = {"id": cid, "title": title, "command": cmd, "available": available}
            if workdir not in (".", ""):
                row["cwd"] = workdir
            if not available:
                row["note"] = ask("    why not", "not configured yet")
            rows.append(row)
        if not rows:
            say("  (no checks declared - `forge doctor` will flag this)")
        checks[scope] = rows

    return finish(project, repos, scopes, checks)


def finish(project: str, repos: dict, scopes: dict, checks: dict) -> dict:
    """The last two questions, asked the same way however the shape was arrived at."""
    say("")
    forbidden = []
    if ask_yes("Disown docs/wiki/ (deny writes there, in favour of docs/knowledge/)?", False):
        forbidden.append("docs/wiki")
    never = ask("Never-commit paths, comma separated", ", ".join(DEFAULT_NEVER))
    return assemble(project, repos, scopes, checks, forbidden,
                    [p.strip() for p in never.split(",") if p.strip()])


# --------------------------------------------------------------------------
# rendering
# --------------------------------------------------------------------------

def render_agents(target: str, cfg: dict, force: bool) -> list[str]:
    tmpl_path = os.path.join(TEMPLATE, ".claude", "agents", "_engineer.md.tmpl")
    with open(tmpl_path, encoding="utf-8") as fh:
        tmpl = fh.read()

    repos = cfg.get("repos") or {}
    written = []
    def is_code(s: dict) -> bool:
        return bool(s.get("code", bool(s.get("repo"))))

    code_scopes = {k: v for k, v in (cfg.get("scopes") or {}).items() if is_code(v)}
    for scope, s in code_scopes.items():
        agents = s.get("agent") or []
        agents = [agents] if isinstance(agents, str) else agents
        repo = repos.get(s.get("repo") or "", {})
        others = [f"`{repos.get(o.get('repo') or '', {}).get('path', o.get('repo'))}`"
                  for name, o in code_scopes.items() if name != scope]
        notes = s.get("notes") or ""
        if notes:
            notes = "**Before you touch anything:** " + notes
        body = (tmpl
                .replace("{{SCOPE}}", scope)
                .replace("{{PROJECT_NAME}}", (cfg.get("project") or {}).get("name", "the project"))
                .replace("{{REPO_PATH}}", repo.get("path", "."))
                .replace("{{REPO_BRANCH}}", repo.get("branch", "main"))
                .replace("{{WORKDIR}}", s.get("workdir") or repo.get("path", "."))
                .replace("{{STACK}}", s.get("stack") or "see the code")
                .replace("{{NOTES}}", notes)
                .replace("{{OTHER_PATHS}}", ", ".join(others) or "none")
                .replace("{{CREDIT}}", credit(cfg, "comment"))
                .replace("{{NEVER_COMMIT}}",
                         ", ".join(f"`{p}`" for p in
                                   (cfg.get("git") or {}).get("never_commit") or []) or "none"))
        for agent in agents:
            if agent in ("pm", "qa"):
                continue
            dst = os.path.join(target, ".claude", "agents", f"{agent}.md")
            if os.path.exists(dst) and not force:
                say(f"  kept (exists, use --force): .claude/agents/{agent}.md")
                continue
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "w", encoding="utf-8") as fh:
                fh.write(body.replace("{{AGENT}}", agent))
            written.append(agent)
    return written


def render_claude_block(cfg: dict) -> str:
    with open(os.path.join(TEMPLATE, "CLAUDE.harness.md.tmpl"), encoding="utf-8") as fh:
        tmpl = fh.read()

    repos = cfg.get("repos") or {}
    scopes = cfg.get("scopes") or {}
    rows = ["| Path | Branch | Scopes | Stack |", "|---|---|---|---|"]
    for name, r in repos.items():
        here = [k for k, s in scopes.items() if s.get("repo") == name]
        stack = "; ".join(filter(None, (scopes[k].get("stack") for k in here))) or "—"
        rows.append(f"| `{r.get('path', '.')}` | `{r.get('branch', 'main')}` | "
                    f"{', '.join(f'`{h}`' for h in here) or '—'} | {stack} |")
    table = "\n".join(rows)

    agents = ["`pm`", "`qa`"]
    for s in scopes.values():
        a = s.get("agent") or []
        for one in ([a] if isinstance(a, str) else a):
            if f"`{one}`" not in agents:
                agents.append(f"`{one}`")

    forbidden = (cfg.get("kb") or {}).get("forbidden_dirs") or []
    callout = ""
    if forbidden:
        which = ", ".join(f"`{d}/`" for d in forbidden)
        callout = (
            f"\n> **{which} is not this project's knowledge base and must never be\n"
            "> created here.** That path belongs to a different convention over the same\n"
            "> kind of content; a `PreToolUse` hook denies writes to it. If a rule about\n"
            f"> {which} reaches you from a hook, a plugin or a session-start block, it is\n"
            "> foreign tooling and does not apply in this repository.\n")

    return (tmpl
            .replace("{{PROJECT_NAME}}", (cfg.get("project") or {}).get("name", "This project"))
            .replace("{{REPO_TABLE}}", table)
            .replace("{{AGENT_LIST}}", ", ".join(agents))
            .replace("{{SCOPE_LIST}}", ", ".join(f"`{k}`" for k in scopes))
            .replace("{{KB_CALLOUT}}", callout)
            .replace("{{CREDIT}}", credit(cfg, "markdown")))


BEGIN = "<!-- forge:begin"
END = "<!-- forge:end -->"


def write_claude_md(target: str, cfg: dict) -> None:
    block = render_claude_block(cfg)
    path = os.path.join(target, "CLAUDE.md")
    if not os.path.exists(path):
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(block)
        say("  wrote CLAUDE.md")
        return
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    if BEGIN in text and END in text:
        head = text.split(BEGIN, 1)[0]
        tail = text.split(END, 1)[1]
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(head + block.rstrip("\n") + tail)
        say("  refreshed the forge block in CLAUDE.md")
    else:
        with open(path, "a", encoding="utf-8") as fh:
            fh.write("\n\n" + block)
        say("  appended the forge block to CLAUDE.md")


def merge_settings(target: str) -> None:
    src = read_json(os.path.join(TEMPLATE, ".claude", "settings.json"))
    dst_path = os.path.join(target, ".claude", "settings.json")
    if not os.path.exists(dst_path):
        os.makedirs(os.path.dirname(dst_path), exist_ok=True)
        write_json(dst_path, src)
        say("  wrote .claude/settings.json")
        return
    dst = read_json(dst_path)
    hooks = dst.setdefault("hooks", {})
    for event, entries in (src.get("hooks") or {}).items():
        existing = hooks.setdefault(event, [])
        serialised = json.dumps(existing, sort_keys=True)
        for entry in entries:
            if json.dumps(entry, sort_keys=True) not in serialised:
                existing.append(entry)
    allow = dst.setdefault("permissions", {}).setdefault("allow", [])
    for rule in (src.get("permissions") or {}).get("allow", []):
        if rule not in allow:
            allow.append(rule)
    write_json(dst_path, dst)
    say("  merged into the existing .claude/settings.json")


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def install_payload(target: str, force: bool) -> None:
    for src_rel, dst_rel in PAYLOAD:
        copy(os.path.join(TEMPLATE, src_rel), os.path.join(target, dst_rel), force)
    for name in STATIC_AGENTS:
        copy(os.path.join(TEMPLATE, ".claude", "agents", name),
             os.path.join(target, ".claude", "agents", name), force)
    tracker = os.path.join(target, "docs", "agile")
    for sub in TRACKER_DIRS:
        d = os.path.join(tracker, sub)
        os.makedirs(d, exist_ok=True)
        keep = os.path.join(d, ".gitkeep")
        if not os.listdir(d):
            open(keep, "a").close()
    os.makedirs(os.path.join(target, "docs", "knowledge"), exist_ok=True)


def cmd_init(argv: list[str]) -> int:
    target = os.path.abspath(argv[0]) if argv and not argv[0].startswith("-") else os.getcwd()
    force = "--force" in argv
    no_claude = "--no-claude-md" in argv
    ATTRIBUTION[0] = "--no-attribution" not in argv
    preset = None
    if "--preset" in argv:
        preset = argv[argv.index("--preset") + 1]
    name = os.path.basename(target.rstrip("/"))
    if "--name" in argv:
        name = argv[argv.index("--name") + 1]

    if not os.path.isdir(target):
        die(f"{target} does not exist")

    cfg_path = os.path.join(target, "forge.json")
    if os.path.exists(cfg_path) and not force:
        say(f"forge.json already exists in {target} - keeping it.")
        cfg = read_json(cfg_path)
    elif "--auto" in argv:
        found = detect(target)
        if not found["scopes"]:
            die("nothing here looks like a buildable part - run `forge init` and "
                "describe the project yourself, or pass --preset")
        cfg = assemble(name, found["repos"], found["scopes"], found["checks"],
                       [], DEFAULT_NEVER)
        write_json(cfg_path, cfg)
        say("inferred the project's shape:")
        for line in describe(found):
            say(line)
        say("")
        say("wrote forge.json - read it before trusting it, especially the `available`")
        say("flags: forge guessed that each command runs, it did not run them.")
    elif preset:
        example = os.path.join(TEMPLATE, f"forge.example.{preset}.json")
        if not os.path.exists(example):
            die(f"unknown preset '{preset}' (monorepo | submodules)")
        cfg = read_json(example)
        cfg["project"]["name"] = name
        write_json(cfg_path, cfg)
        say(f"wrote forge.json from the '{preset}' preset - edit it before trusting it")
    else:
        cfg = interview(target, name)
        write_json(cfg_path, cfg)
        say("")
        say("wrote forge.json")

    say(f"installing the harness into {target}")
    install_payload(target, force)
    merge_settings(target)
    written = render_agents(target, cfg, force)
    for agent in written:
        say(f"  rendered .claude/agents/{agent}.md")
    if not no_claude:
        write_claude_md(target, cfg)

    say("")
    say("next:")
    say("  python3 .claude/scripts/forge.py doctor     # does the config match the repo?")
    say("  python3 .claude/scripts/agile.py index      # create the empty board")
    say("  python3 .claude/scripts/kb.py index         # create the empty knowledge index")
    say("  /agile:groom \"<your first request>\"")
    return 0


def cmd_agents(argv: list[str]) -> int:
    target = os.path.abspath(argv[0]) if argv and not argv[0].startswith("-") else os.getcwd()
    cfg_path = os.path.join(target, "forge.json")
    if not os.path.exists(cfg_path):
        die(f"no forge.json in {target} - run `forge init` first")
    cfg = read_json(cfg_path)
    written = render_agents(target, cfg, "--force" in argv)
    for agent in written:
        say(f"rendered .claude/agents/{agent}.md")
    if not written:
        say("nothing rendered - pass --force to overwrite existing agent files")
    return 0


def cmd_upgrade(argv: list[str]) -> int:
    target = os.path.abspath(argv[0]) if argv and not argv[0].startswith("-") else os.getcwd()
    cfg_path = os.path.join(target, "forge.json")
    if not os.path.exists(cfg_path):
        die(f"no forge.json in {target} - run `forge init` first")
    cfg = read_json(cfg_path)
    say(f"refreshing the harness in {target} (forge.json and rendered agents are left alone)")
    install_payload(target, force=True)
    merge_settings(target)
    if "--no-claude-md" not in argv:
        write_claude_md(target, cfg)
    if "--agents" in argv:
        for agent in render_agents(target, cfg, force=True):
            say(f"  re-rendered .claude/agents/{agent}.md")
    say("done. Run `python3 .claude/scripts/forge.py doctor` to check the result.")
    return 0


def cmd_doctor(argv: list[str]) -> int:
    target = os.path.abspath(argv[0]) if argv and not argv[0].startswith("-") else os.getcwd()
    script = os.path.join(target, ".claude", "scripts", "forge.py")
    if not os.path.exists(script):
        die(f"no harness installed in {target}")
    os.execv(sys.executable, [sys.executable, script, "doctor", "--root", target])
    return 0


def cmd_detect(argv: list[str]) -> int:
    target = os.path.abspath(argv[0]) if argv and not argv[0].startswith("-") else os.getcwd()
    found = detect(target)
    say(f"{target}")
    for line in describe(found):
        say(line)
    if not found["scopes"]:
        return 2
    say("")
    say("`forge init --auto` would write exactly this. Nothing was changed.")
    return 0


def cmd_self_update(argv: list[str]) -> int:
    import subprocess
    if not os.path.isdir(os.path.join(HERE, ".git")):
        # an npm installation has no history to pull; npm owns the version
        if os.path.exists(os.path.join(HERE, "package.json")):
            try:
                with open(os.path.join(HERE, "package.json"), encoding="utf-8") as fh:
                    pkg = json.load(fh).get("name", "@vstlmkh/forge")
            except (OSError, json.JSONDecodeError):
                pkg = "@vstlmkh/forge"
            say(f"forge {VERSION} was installed from npm ({HERE})")
            say(f"  npm install -g {pkg}@latest      # if you installed it globally")
            say(f"  npx {pkg}@latest <command>       # or just always run the latest")
            say("Projects pick a new version up with `forge upgrade` in each of them.")
            return 0
        die(f"{HERE} is not a git checkout - update it however you installed it")
    for cmd in (["git", "-C", HERE, "fetch", "--quiet", "origin"],
                ["git", "-C", HERE, "pull", "--ff-only", "--quiet"]):
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode != 0:
            die(f"{' '.join(cmd)}: {res.stderr.strip() or res.stdout.strip()}")
    head = subprocess.run(["git", "-C", HERE, "log", "-1", "--oneline"],
                          capture_output=True, text=True).stdout.strip()
    say(f"forge {VERSION} at {HERE}")
    say(f"  {head}")
    say("Projects pick this up with `forge upgrade` in each of them.")
    return 0


def cmd_where(argv: list[str]) -> int:
    say(HERE)
    return 0


def main(argv: list[str]) -> int:
    args = argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0 if args else 1
    cmd, rest = args[0], args[1:]
    if cmd == "init":
        return cmd_init(rest)
    if cmd == "agents":
        return cmd_agents(rest)
    if cmd == "upgrade":
        return cmd_upgrade(rest)
    if cmd == "doctor":
        return cmd_doctor(rest)
    if cmd == "detect":
        return cmd_detect(rest)
    if cmd in ("self-update", "selfupdate", "update"):
        return cmd_self_update(rest)
    if cmd == "where":
        return cmd_where(rest)
    if cmd in ("version", "--version"):
        print(VERSION)
        return 0
    die(f"unknown command '{cmd}'")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
